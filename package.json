{
  "name": "skills-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "fonts:build": "uv run scripts/build-font-subsets.py",
    "catalog:sync": "node scripts/import-ant-skills.mjs",
    "build": "npm run catalog:sync && npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "antd": "6.7.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@types/mdast": "4.0.4",
    "@types/node": "26.6.11",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
